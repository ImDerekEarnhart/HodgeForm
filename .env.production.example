HODGEFORM_DOMAIN=hodgeform.example.com
HODGEFORM_RELEASE_CHANNEL=controlled_beta
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
HODGEFORM_ALLOW_SIGNUPS=false
HODGEFORM_DEPLOYMENT_MODE=saas
# Private deployment only:
HODGEFORM_PRIVATE_TENANT_ID=
HODGEFORM_SIGNER_ID=your-org-release-authority
HODGEFORM_RECEIPT_PRIVATE_KEY_B64=
HODGEFORM_RECEIPT_PUBLIC_KEY_B64=
HODGEFORM_STUDENT_MODEL=qwen3:8b
HODGEFORM_TEACHER_MODEL=qwen3:14b
HODGEFORM_REQUIRED_POLICY_PACKS=
HODGEFORM_REQUIRE_SEPARATE_APPROVER=false
HODGEFORM_EMAIL_PROVIDER=resend
RESEND_API_KEY=
HODGEFORM_EMAIL_FROM=HodgeForm <no-reply@example.com>

# Optional defense-in-depth token for a separately hosted/reference executor.
HODGEFORM_SANDBOX_TOKEN=replace-with-random-service-token

# Public-product operator identity and reviewed policy pages.
HODGEFORM_LEGAL_ENTITY_NAME=Example Corp
HODGEFORM_LEGAL_EFFECTIVE_DATE=2026-09-03
HODGEFORM_SUPPORT_EMAIL=support@example.com
HODGEFORM_SECURITY_EMAIL=security@example.com
HODGEFORM_PRIVACY_EMAIL=privacy@example.com
HODGEFORM_DATA_RETENTION_DAYS=30
# Required only for HODGEFORM_RELEASE_CHANNEL=public_ga. Set to true only after
# qualified counsel has reviewed the deployed Terms/Privacy terms.
HODGEFORM_LEGAL_REVIEWED=false
