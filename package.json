{
  "name": "hodgeform",
  "version": "1.1.0",
  "private": true,
  "description": "Deterministic trust compiler and release gate for consequential AI work.",
  "type": "module",
  "bin": {
    "hodgeform": "./bin/hodgeform.mjs"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "node --experimental-strip-types --test 'tests/**/*.test.mjs' 'scripts/**/*.test.mjs'",
    "security:check": "node --test tests/security.test.mjs tests/receipt-verifier.test.mjs",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run trust:check && npm run brand:check && npm run build",
    "receipt:verify": "node bin/hodgeform.mjs receipt verify",
    "brand:check": "node scripts/brand-smoke.mjs",
    "demo:trust": "node --experimental-strip-types scripts/trust-boundary-demo.mjs",
    "benchmark:trust": "node --experimental-strip-types scripts/trustbench.mjs",
    "trust:check": "npm run demo:trust && npm run benchmark:trust"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "better-auth": "~1.6.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22 <24"
  }
}
