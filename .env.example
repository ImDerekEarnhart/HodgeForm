# Safe production baseline: invite-only controlled beta.
# Public GA must be an explicit promotion after its external gates are complete.
NODE_ENV=production
HODGEFORM_RELEASE_CHANNEL=controlled_beta
VITE_AUTH_ENABLED=true
HODGEFORM_EMAIL_PASSWORD_AUTH=true
HODGEFORM_ALLOW_SIGNUPS=false
BETTER_AUTH_URL=https://hodgeform.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://hodgeform:replace-me@postgres:5432/hodgeform

# Multi-tenancy. "saas" provides user-created team workspaces and role-based approval.
# "private" puts all authenticated operators in one deployment tenant; identity is still required.
HODGEFORM_DEPLOYMENT_MODE=saas
HODGEFORM_PRIVATE_TENANT_ID=replace-only-if-mode-is-private

# Ed25519 release authority. Required for every production release channel.
# Generate with: node bin/hodgeform.mjs keys generate
HODGEFORM_RECEIPT_PRIVATE_KEY_B64=
HODGEFORM_RECEIPT_PUBLIC_KEY_B64=
HODGEFORM_SIGNER_ID=your-org-release-authority

# Local-first OpenAI-compatible inference (Ollama/llama.cpp/vLLM)
HODGEFORM_MODEL_BASE_URL=http://ollama:11434/v1
HODGEFORM_STUDENT_MODEL=qwen3:8b
HODGEFORM_TEACHER_MODEL=qwen3:14b
HODGEFORM_MODEL_TIMEOUT_MS=45000
HODGEFORM_ALLOW_XAI_FALLBACK=false
# XAI_API_KEY=

# Isolated executor. Prefer the Unix socket topology in docker-compose.production.yml.
HODGEFORM_SANDBOX_SOCKET=/runtime/sandbox/sandbox.sock
HODGEFORM_SANDBOX_TOKEN=replace-with-random-service-token
HODGEFORM_AGENT_REQUESTS_PER_MINUTE=20

# Optional signup controls
HODGEFORM_MIN_PASSWORD_LENGTH=12

# Operator-enforced policy overlays. Repository users can add stricter requirements but cannot remove these.
# Comma-separated: basic,networked,code-execution,action-taking,high-risk
HODGEFORM_REQUIRED_POLICY_PACKS=
HODGEFORM_REQUIRE_SEPARATE_APPROVER=false

# Required before enabling open signup.
HODGEFORM_EMAIL_PROVIDER=resend
RESEND_API_KEY=
HODGEFORM_EMAIL_FROM=HodgeForm <no-reply@example.com>
